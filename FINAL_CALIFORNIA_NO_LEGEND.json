{
  "version": 8,
  "name": "OSM Liberty",
  "metadata": {
    "maputnik:license": "https://github.com/maputnik/osm-liberty/blob/gh-pages/LICENSE.md",
    "maputnik:renderer": "mbgljs",
    "openmaptiles:version": "3.x"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
  "url": "https://tiles.openfreemap.org/planet"
}
    },
    "natural_earth_shaded_relief": {
      "maxzoom": 6,
      "tileSize": 256,
      "tiles": [
        "https://klokantech.github.io/naturalearthtiles/tiles/natural_earth_2_shaded_relief.raster/{z}/{x}/{y}.png"
      ],
      "type": "raster"
    },
    "8peocxh": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/lillian757391/exploratory_lab_1/main/points.geojson"
    },
    "cali": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/lillian757391/exploratory_lab_1/main/california.json"
    },
    "just_cali_bike_scores": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/lillian757391/exploratory_lab_1/main/cali_new.geojson"
    },
    "3s2jror": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/lillian757391/exploratory_lab_1/main/california (1).json"
    }
  },
  "sprite": "https://maputnik.github.io/osm-liberty/sprites/osm-liberty",
  "glyphs": "https://orangemug.github.io/font-glyphs/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "rgba(23, 4, 4, 1)"}
    },
    {
      "id": "country_3",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", [">=", "rank", 3], ["==", "class", "country"]],
      "layout": {
        "text-field": "{name_en}",
        "text-font": ["Roboto Condensed Italic"],
        "text-max-width": 6.25,
        "text-size": {"stops": [[3, 11], [7, 17]]},
        "text-transform": "none",
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#334",
        "text-halo-blur": 1,
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1
      }
    },
    {
      "id": "country_2",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", "rank", 2], ["==", "class", "country"]],
      "layout": {
        "text-field": "{name_en}",
        "text-font": ["Roboto Condensed Italic"],
        "text-max-width": 6.25,
        "text-size": {"stops": [[2, 11], [5, 17]]},
        "text-transform": "none",
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#334",
        "text-halo-blur": 1,
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1
      }
    },
    {
      "id": "country_1",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", "rank", 1], ["==", "class", "country"]],
      "layout": {
        "text-field": "{name_en}",
        "text-font": ["Roboto Condensed Italic"],
        "text-max-width": 6.25,
        "text-size": {"stops": [[1, 11], [4, 17]]},
        "text-transform": "none",
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#334",
        "text-halo-blur": 1,
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1
      }
    },
    {
      "id": "continent",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 1,
      "filter": ["all", ["==", "class", "continent"]],
      "layout": {
        "text-field": "{name_en}",
        "text-font": ["Roboto Condensed Italic"],
        "text-size": 13,
        "text-transform": "uppercase",
        "text-justify": "center",
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#633",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1
      }
    },
    {
      "id": "new california map",
      "type": "fill",
      "source": "3s2jror",
      "paint": {
        "fill-color": {
          "property": "new_cali_S1901_C01_012E",
          "type": "interval",
          "stops": [
            [{"value": 0, "zoom": 0}, "rgba(218, 216, 216, 1)"],
            [{"value": 50000, "zoom": 0}, "rgba(164, 158, 158, 1)"],
            [{"value": 100000, "zoom": 0}, "rgba(127, 124, 124, 1)"],
            [{"value": 150000, "zoom": 0}, "rgba(94, 92, 92, 1)"],
            [{"value": 200000, "zoom": 0}, "rgba(67, 66, 66, 1)"],
            [{"value": 250000, "zoom": 0}, "rgba(18, 18, 18, 1)"]
          ],
          "default": "rgba(174, 139, 185, 1)"
        },
        "fill-outline-color": "rgba(0, 0, 0,.2)",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["all", ["!=", "brunnel", "tunnel"]],
      "layout": {"visibility": "visible"},
      "paint": {"fill-color": "rgba(29, 54, 75, 1)"}
    },
    {
      "id": "cali score color",
      "type": "circle",
      "source": "just_cali_bike_scores",
      "layout": {"visibility": "visible"},
      "paint": {
        "circle-color": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          [
            "step",
            ["number", ["get", "rounded_score"]],
            "#d7191c",
            20,
            "#f04b25",
            30,
            "#ff8c38",
            40,
            "#ffb74d",
            50,
            "#ffd166",
            60,
            "#fff176",
            70,
            "#e6ee9c",
            80,
            "#c5e1a5",
            90,
            "#4caf50"
          ]
        ],
        "circle-radius": {
          "property": "census_population",
          "type": "interval",
          "stops": [
            [{"value": 0, "zoom": 5}, 4],
            [{"value": 50000, "zoom": 5}, 6],
            [{"value": 100000, "zoom": 5}, 8],
            [{"value": 250000, "zoom": 5}, 10],
            [{"value": 500000, "zoom": 5}, 12],
            [{"value": 1000000, "zoom": 5}, 14],
            [{"value": 0, "zoom": 7}, 8],
            [{"value": 50000, "zoom": 7}, 10],
            [{"value": 100000, "zoom": 7}, 12],
            [{"value": 250000, "zoom": 7}, 14],
            [{"value": 500000, "zoom": 7}, 16],
            [{"value": 1000000, "zoom": 7}, 18]
          ]
        },
        "circle-opacity": 0.75
      }
    },
    {
      "id": "city_names-large",
      "type": "symbol",
      "source": "just_cali_bike_scores",
      "minzoom": 5.5,
      "filter": ["all", [">", "census_population", 500000]],
      "layout": {
        "text-field": {"type": "identity", "property": "city"},
        "text-font": ["Open Sans Regular"],
        "text-anchor": "bottom-left",
        "visibility": "visible",
        "text-transform": "uppercase",
        "text-radial-offset": 1.2,
        "text-size": 20
      },
      "paint": {"text-color": "rgba(255, 255, 255, 1)"}
    },
    {
      "id": "city_names_small",
      "type": "symbol",
      "source": "just_cali_bike_scores",
      "minzoom": 9,
      "filter": ["all", ["<", "census_population", 100000]],
      "layout": {
        "text-field": {"type": "identity", "property": "city"},
        "text-font": ["Open Sans Regular"],
        "visibility": "visible",
        "text-size": 12,
        "text-transform": "uppercase",
        "icon-anchor": "center",
        "text-anchor": "bottom-left",
        "text-radial-offset": 1.2
      },
      "paint": {"text-color": "rgba(255, 255, 255, 1)"}
    },
    {
      "id": "city_names_medium",
      "type": "symbol",
      "source": "just_cali_bike_scores",
      "minzoom": 8,
      "filter": [
        "all",
        [">=", "census_population", 100000],
        ["<", "census_population", 500000]
      ],
      "layout": {
        "text-field": {"type": "identity", "property": "city"},
        "text-size": 16,
        "text-font": ["Open Sans Regular"],
        "visibility": "visible",
        "text-transform": "uppercase",
        "text-justify": "auto",
        "text-anchor": "bottom-left",
        "text-radial-offset": 1.2
      },
      "paint": {"text-color": "rgba(255, 255, 255, 1)"}
    }
  ],
  "id": "osm-liberty"
}
